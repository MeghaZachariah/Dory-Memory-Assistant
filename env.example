# Copy to .env and fill in. Never commit .env: it holds your keys.

# --- Dory server (backend/api) ---------------------------------------------
NEBIUS_API_KEY=your-nebius-token-factory-key
# sqlite = keep data in db/dory.db (accounts, memories, questions); anything else = in memory
DORY_DB=sqlite
# 1 = every request needs a family login (turn on once the website and bot send tokens)
DORY_REQUIRE_LOGIN=0
# The demo login judges use (demo@dory.app): pick your own password before going online
DORY_DEMO_PASSWORD=dory-demo-2026
# Hosting (deploy/setup.sh fills these in): the server's name, and who may call the API
# DORY_DOMAIN=1-2-3-4.sslip.io
# DORY_CORS_ORIGINS=https://1-2-3-4.sslip.io
# Optional: one shared password for the whole server (header X-Dory-Token)
# DORY_APP_TOKEN=
# Family voice (optional): the Colab voice server. Can also be set with PUT /voice-server.
DORY_VOICE_URL=
DORY_VOICE_TOKEN=

# --- Telegram family bot (backend/bot) -------------------------------------
TELEGRAM_BOT_TOKEN=your-token-from-BotFather
DORY_API=http://localhost:8000
DORY_PERSON_ID=mary
FAMILY_CODE=replace-with-family-code
CAREGIVER_CODE=replace-with-caregiver-code
DORY_TZ=Asia/Kolkata
REMIND_AFTER_MIN=30
# Optional path override for tests or a separate deployment:
# DORY_REGISTRY=/var/lib/dory/registry.json
